# Copy this file to .env. Everything here is optional.
# Without it the app still runs in demo mode with scripted replies and browser voice.

# Gemini powers adaptive conversation from the learner's free-form input.
# Create a key in Google AI Studio and keep it server-side. Never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keeps saved custom moments valid if you rotate the Gemini key or run multiple app instances.
# Use a long random value in production. If omitted, the Gemini key is used for local development.
# MOMENT_SIGNING_SECRET=

# AWS is only used for optional Mandarin text-to-speech.
AWS_REGION=ap-southeast-1

# AWS credentials: run `aws configure`, or fill these in.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Amazon Polly (Mandarin text to speech). Defaults are shown.
# POLLY_VOICE=Zhiyu
# POLLY_ENGINE=neural
# POLLY_REGION=ap-southeast-1

PORT=8787

# Feedback inbox. Learners' feedback is saved to server/feedback.jsonl.
# Set ADMIN_KEY to enable the protected API, then send it in an Authorization header:
# curl -H "Authorization: Bearer YOUR_KEY" http://localhost:8787/api/feedback
# ADMIN_KEY=
# FEEDBACK_FILE=
