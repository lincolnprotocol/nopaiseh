# Copy this file to .env. Everything here is optional.
# Without it the app still runs in demo mode with scripted replies and browser voice.

AWS_REGION=ap-southeast-1

# AWS credentials: run `aws configure`, or fill these in.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Paste the exact model ID (or inference profile ID) that the Bedrock console shows
# for a Claude model you have been granted access to. Leave empty for demo mode.
BEDROCK_MODEL_ID=

# Amazon Polly (Mandarin text to speech). Defaults are shown.
# POLLY_VOICE=Zhiyu
# POLLY_ENGINE=neural
# POLLY_REGION=ap-southeast-1

PORT=8787

# Feedback inbox. Learners' feedback is saved to server/feedback.jsonl.
# Set ADMIN_KEY to read it at /api/feedback?key=YOUR_KEY (or run `npm run feedback`).
# ADMIN_KEY=
# FEEDBACK_FILE=
